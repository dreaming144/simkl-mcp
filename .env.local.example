# Copy to .env.local (gitignored, chmod 600) and fill in. Names only here; never commit real values.

# Required. Public client id of your Simkl developer app
# (type "TV, devices & command line"; https://simkl.com/settings/developer/).
SIMKL_CLIENT_ID=

# Written by simkl_device_poll / simkl_token_refresh after the device flow (or paste an existing token).
# With PLUGIN_DATA set, the file lives at $PLUGIN_DATA/.env.local instead.
SIMKL_ACCESS_TOKEN=
SIMKL_REFRESH_TOKEN=
# Granted scope (written by the server; e.g. "media:read media:write"). Unknown/empty = writes allowed with a note.
SIMKL_SCOPE=

# Optional. Server-type apps only; not needed for device flow.
SIMKL_CLIENT_SECRET=

# Optional overrides (defaults: simkl-mcp / 0.1.2).
SIMKL_APP_NAME=
SIMKL_APP_VERSION=
